@echo off
title Instalando REFRIMAR POS
echo.
echo   Instalando REFRIMAR POS... no cierres esta ventana.
powershell -NoProfile -ExecutionPolicy Bypass -Command "$ErrorActionPreference='Stop'; $t=[IO.File]::ReadAllText('%~f0'); $m='__'+'ARCHIVO'+'__'; $b=$t.Substring($t.LastIndexOf($m)+$m.Length) -replace '[^A-Za-z0-9+/=]',''; $d=Join-Path $env:LOCALAPPDATA 'RefrimarPOS'; New-Item -ItemType Directory -Force $d | Out-Null; $z=Join-Path $env:TEMP 'refrimar_pos.zip'; [IO.File]::WriteAllBytes($z,[Convert]::FromBase64String($b)); Add-Type -AssemblyName System.IO.Compression.FileSystem; $a=[IO.Compression.ZipFile]::OpenRead($z); foreach($e in $a.Entries){ [IO.Compression.ZipFileExtensions]::ExtractToFile($e,(Join-Path $d $e.FullName),$true) }; $a.Dispose(); Remove-Item $z"
if errorlevel 1 (
  echo.
  echo   No se pudieron copiar los archivos. Vuelve a descargar el instalador.
  pause
  exit /b 1
)
powershell -NoProfile -ExecutionPolicy Bypass -File "%LOCALAPPDATA%\RefrimarPOS\instalar.ps1"
exit /b 0

