async function loadTopProductos() {
    var grid = document.getElementById('top-grid');
    var suc = window.getSucursalActual ? window.getSucursalActual() : { id: window.CASA_MATRIZ_ID, nombre: 'Casa Matriz' };
    document.getElementById('top-sucursal').textContent = (suc.nombre || 'Casa Matriz').toUpperCase();
    grid.innerHTML = '<div class="col-span-full text-on-surface-variant text-sm py-2">Cargando…</div>';
    var r = await supabaseClient.rpc('top_productos_vendidos', { p_sucursal_id: suc.id });
    if (r.error || !r.data || !r.data.length) { grid.innerHTML = '<div class="col-span-full text-on-surface-variant text-sm py-2">Aún sin ventas para mostrar.</div>'; return; }
    topData = r.data;
    grid.innerHTML = topData.map(function(t) {
        var color = Number(t.stock) <= 0 ? '#ef4444' : Number(t.stock) <= 5 ? '#f59e0b' : '#22c55e';
        return '<button type="button" data-codigo="' + esc(t.producto_codigo) + '" class="text-left flex flex-col gap-1 rounded-lg border border-outline-variant/40 bg-surface-container-low p-2.5 hover:bg-secondary/5 active:scale-[0.98] transition-transform" title="Agregar a la factura"><span class="font-mono-data text-[10px] text-secondary font-bold truncate">' + esc(t.producto_codigo) + '</span><span class="text-[11px] leading-tight truncate">' + esc(t.descripcion || t.producto_codigo) + '</span><span class="flex items-center gap-1 text-[10px] font-bold" style="color:' + color + '"><span class="inline-block w-2 h-2 rounded-full" style="background:' + color + '"></span>' + Number(t.cantidad) + ' vend.</span></button>';
    }).join('');
    grid.querySelectorAll('button[data-codigo]').forEach(function(b) {
        b.addEventListener('click', function() {
            var p = CATALOGO.find(function(x) { return x.codigo === b.dataset.codigo; });
            if (p) { addItemToSale(p); return; }
            var t = topData.find(function(x) { return x.producto_codigo === b.dataset.codigo; });
            if (t) {
                if (Number(t.stock) <= 0) { showToast('Producto sin stock disponible', 'error'); return; }
                addItemToSale({ id: null, codigo: t.producto_codigo, descripcion: t.descripcion || t.producto_codigo, precio: Number(t.precio), costo: 0, cantidad: 1, descuento: 0, stock: Number(t.stock), unidad: 'uds' });
            }
        });
    });
}
