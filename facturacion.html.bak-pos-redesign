var TICKET_SUCURSAL_NOMBRE = null;
var lastSalesList = [];
async function loadSales() {
    var loadingEl = document.getElementById('sales-loading');
    loadingEl.classList.remove('hidden-modal');
    var res = await supabaseClient.from('ventas').select('*').order('created_at', { ascending: false }).limit(20);
    if (res.error) {
        var cache = window.refCacheGet('refrimar_cache_sales');
        if (cache) { lastSalesList = cache; renderSalesList(cache); loadingEl.classList.add('hidden-modal'); }
        else loadingEl.textContent = 'Error al cargar.';
        return;
    }
    var data = res.data || [];
    window.refCacheSet('refrimar_cache_sales', data);
    lastSalesList = data;
    loadingEl.classList.add('hidden-modal');
    renderSalesList(data);
}
function renderPendientes() { renderSalesList(lastSalesList); }
function quitarPendiente(id) {
    if (!confirm('¿Quitar esta venta pendiente de la cola local? Se descartará si aún no fue sincronizada.')) return;
