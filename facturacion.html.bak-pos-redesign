    }
}

async function fetchAllProductos() {
    var all = [];
    var from = 0;
    var pageSize = 1000;
    while (true) {
        var res = await supabaseClient
            .from('productos')
            .select('*')
            .order('descripcion')
            .range(from, from + pageSize - 1);
        if (res.error) return res;
        all = all.concat(res.data || []);
        if (!res.data || res.data.length < pageSize) break;
        from += pageSize;
    }
    return { data: all, error: null };
}

async function loadCatalogo() {
    var actual = window.getSucursalActual ? window.getSucursalActual() : { id: window.CASA_MATRIZ_ID, nombre: 'Casa Matriz' };
    document.getElementById('fact-sucursal-badge').textContent = actual.nombre || 'Casa Matriz';
    var cacheKey = 'refrimar_cache_catalogo_' + actual.id;

    connStatus.textContent = 'Conectando...';
    var res = await fetchAllProductos();
    if (res.error) {
        // Sin internet: usa la última copia del catálogo guardada en el dispositivo.
        var cache = window.refCacheGet(cacheKey);
        if (cache && cache.length) {
            CATALOGO = cache;
            connStatus.textContent = '🔴 ' + CATALOGO.length + ' productos (caché offline)';
            connStatus.className = 'text-xs font-mono-data px-3 py-1 rounded-full bg-amber-100 text-amber-700 font-bold';
            recalculateTotals();
        } else {
            connStatus.textContent = 'Sin conexión y sin caché';
            connStatus.className = 'text-xs font-mono-data px-3 py-1 rounded-full bg-error/10 text-error font-bold';
        }
        return;
    }
    var base = res.data.map(function(p) { return { id: p.id, codigo: p.codigo, descripcion: p.descripcion, precio: Number(p.precio), costo: p.costo != null ? Number(p.costo) : 0, stock: p.stock != null ? Number(p.stock) : 0, unidad: p.unidad || 'uds' }; });

    if (!actual || actual.id === window.CASA_MATRIZ_ID) {
        CATALOGO = base;
    } else {
        var stockRes = await supabaseClient.from('sucursal_stock').select('producto_codigo,stock').eq('sucursal_id', actual.id);
        if (stockRes.error) { connStatus.textContent = 'Error cargando stock de la sucursal'; connStatus.classList.add('text-error'); return; }
        var stockMap = {};
        (stockRes.data || []).forEach(function(r) { stockMap[r.producto_codigo] = Number(r.stock) || 0; });
        CATALOGO = base
            .filter(function(p) { return stockMap[p.codigo] != null; })
            .map(function(p) { return Object.assign({}, p, { stock: stockMap[p.codigo] }); });
    }
    window.refCacheSet(cacheKey, CATALOGO);
    connStatus.textContent = CATALOGO.length + ' productos cargados';
    connStatus.className = 'text-xs font-mono-data px-3 py-1 rounded-full bg-surface-container-high text-on-surface-variant';
}
