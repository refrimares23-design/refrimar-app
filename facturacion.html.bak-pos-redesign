document.addEventListener('keydown', function(e) {
    if (e.key === 'F1') { e.preventDefault(); newSaleBtn.click(); return; }
    if (e.key === 'F3') { e.preventDefault(); saveSaleBtn.click(); return; }
    if (algunaModalAbierta()) return;
    var el = document.activeElement;
    var tag = el ? el.tagName : '';
    var enInput = tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT';
    if (e.key === 'Escape' && !enInput) {
        if (saleItems.length) { removeItem(saleItems[saleItems.length - 1].codigo); showToast('Último ítem quitado', 'info'); }
        return;
    }
    if (!enInput && (e.key === '1' || e.key === '2' || e.key === '3')) {
        var mapa = { '1': 'efectivo', '2': 'divisa', '3': 'transferencia' };
        var m = mapa[e.key];
        document.getElementById('metodo-pago').value = m;
        showToast('Método de pago: ' + m, 'info');
        e.preventDefault();
    }
});

// ===== Escáner USB: detecta lectura rápida y agrega directo =====
var scanBuf = '';
var scanLastTs = 0;
var scanTimer = null;
var ultimaScan = 0;
document.addEventListener('keydown', function(e) {
    if (!e.key || e.key.length !== 1) return;
    var now = Date.now();
    scanBuf = (now - scanLastTs <= 80) ? scanBuf + e.key : e.key;
    scanLastTs = now;
    if (scanBuf.length < 4) return;
    if (scanTimer) clearTimeout(scanTimer);
    scanTimer = setTimeout(function() {
        var code = scanBuf;
        scanBuf = '';
        var p = buscarPorCodigoExacto(code);
        if (!p) return;
        var el = document.activeElement;
        var esInputProd = el && (el.id === 'quick-codigo' || el.id === 'product-search');
        if (el && /INPUT|TEXTAREA|SELECT/.test(el.tagName) && !esInputProd) return;
        if (esInputProd) el.value = '';
        ultimaScan = Date.now();
        addItemToSale(p);
    }, 260);
});

