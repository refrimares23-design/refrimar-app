        if (audioCtx.state === 'suspended') audioCtx.resume();
        var osc = audioCtx.createOscillator();
        var gain = audioCtx.createGain();
        osc.type = 'square';
        var t = audioCtx.currentTime;
        if (tipo === 'ok') { osc.frequency.setValueAtTime(1250, t); gain.gain.setValueAtTime(0.05, t); osc.stop(t + 0.12); }
        else if (tipo === 'error') { osc.frequency.setValueAtTime(220, t); gain.gain.setValueAtTime(0.09, t); osc.frequency.setValueAtTime(180, t + 0.15); osc.stop(t + 0.3); }
        else { osc.frequency.setValueAtTime(750, t); gain.gain.setValueAtTime(0.05, t); osc.stop(t + 0.15); }
        osc.connect(gain); gain.connect(audioCtx.destination);
        osc.start();
    } catch (e) {}
}

