            p_metodo: metodo,
            p_sucursal_id: actualSuc.id,
            p_sucursal_nombre: actualSuc.nombre,
            p_usuario: CURRENT_USER ? CURRENT_USER.nombre : 'Sistema',
            p_items: items,
            p_pm_banco: pmBanco,
            p_pm_remitente: pmRemitente,
            p_pm_referencia: pmRef,
            p_metodo_2: esMixto ? (mixData ? mixData.metodo2 : null) : null,
            p_efectivo_usd: esMixto ? (mixData ? mixData.efectivoUsd : null) : null,
            p_efectivo_bs: esMixto ? (mixData ? mixData.efectivoBs : null) : null
        },
        metodo: metodo,
        numero: numero,
        totalBs: totals.totalBs,
        actualSuc: actualSuc,
        mixData: esMixto ? mixData : null
    };
}

async function saveSaleToSupabase() {
    var data = construirPayloadVenta();

    // MODO OFFLINE: la venta se guarda localmente y se sincronizará sola.
    if (!window.refEsEnLinea()) {
        window.refEncolarVenta(data.payload);
        lastSaleNumero = data.numero;
        lastSaleLocal = true;
        showToast('Venta guardada LOCALMENTE (sin internet). Se sincronizará sola.', 'info');
        renderPendientes();
        return;
    }

    // MODO EN LÍNEA: transacción atómica en Supabase (todo o nada).
    try {
        var resVenta = await supabaseClient.rpc('registrar_venta', data.payload);
        if (resVenta.error) throw resVenta.error;
        lastSaleNumero = data.numero;
        lastSaleLocal = false;
        showToast('Venta guardada: ' + data.numero, 'success');
        loadSales();
        loadTopProductos();

        // 5. Alerta de WhatsApp si la venta se pagó (total o en parte) con Pago Móvil
        if (data.metodo === 'pago_movil') {
            enviarAlertaPagoMovil({
                monto: data.totalBs.toLocaleString('es-VE', { minimumFractionDigits: 2 }) + ' Bs',
                referencia: (document.getElementById('pm-ref-facturacion').value || '').trim() || '-',
                sucursal: data.actualSuc.nombre || 'Casa Matriz',
                usuario: CURRENT_USER ? CURRENT_USER.nombre : 'Sistema'
            });
        } else if (data.metodo === 'mixto' && data.mixData && data.mixData.metodo2 === 'pago_movil') {
            var efecBs = data.mixData.efectivoBs || 0;
            enviarAlertaPagoMovil({
                monto: (data.totalBs - efecBs).toLocaleString('es-VE', { minimumFractionDigits: 2 }) + ' Bs',
                referencia: data.mixData.pmRef || '-',
                sucursal: data.actualSuc.nombre || 'Casa Matriz',
                usuario: CURRENT_USER ? CURRENT_USER.nombre : 'Sistema'
            });
        }
    } catch (err) {
        // Si la red falló aunque el navegador diga estar en línea, se guarda local.
        if (window.refEsErrorDeRed(err)) {
            window.refEncolarVenta(data.payload);
            lastSaleNumero = data.numero;
            lastSaleLocal = true;
            showToast('Venta guardada LOCALMENTE. Se sincronizará sola.', 'info');
            renderPendientes();
            return;
        }
        throw err;
    }
}

