async function verificarCredito() {
    var rif = document.getElementById('cliente-rif').value.trim();
    if (!rif) return null;
    var totals = recalculateTotals();
    try {
        var res = await supabaseClient.from('clientes').select('rif,nombre,saldo_pendiente,limite_credito').eq('rif', rif).maybeSingle();
        if (res.error || !res.data) return null;
        var saldo = Number(res.data.saldo_pendiente) || 0;
        var limite = Number(res.data.limite_credito) || 0;
        var venta = totals.totalUsd;
        if (limite > 0 && (saldo + venta) > limite) {
            return { nombre: res.data.nombre || rif, rif: rif, saldo: saldo, limite: limite, venta: venta, proyectado: saldo + venta, excedente: (saldo + venta) - limite };
        }
    } catch (e) {}
    return null;
}
