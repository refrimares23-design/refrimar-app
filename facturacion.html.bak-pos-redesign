function addItemToSale(product) {
    if (!product) return;
    if (product.stock <= 0) { showToast('Producto sin stock disponible', 'error'); return; }
    var existing = saleItems.find(function(i) { return i.codigo === product.codigo; });
    if (existing) {
        if (existing.cantidad >= product.stock) { showToast('Stock insuficiente. Disponible: ' + product.stock, 'warning'); return; }
        existing.cantidad += 1;
    } else {
        saleItems.push({ id: product.id, codigo: product.codigo, descripcion: product.descripcion, precio: product.precio, costo: product.costo || 0, cantidad: 1, descuento: 0, stock: product.stock, unidad: product.unidad || 'uds' });
    }
    renderSale();
    beep('ok');
}
function updateQuantity(codigo, delta) { var item = saleItems.find(function(i) { return i.codigo === codigo; }); if (item) { var nuevo = item.cantidad + delta; if (nuevo > item.stock) { showToast('Stock máximo: ' + item.stock, 'warning'); return; } item.cantidad = Math.max(0.001, nuevo); if (item.unidad === 'uds') item.cantidad = Math.max(1, Math.round(item.cantidad)); renderSale(); } }
function setQuantity(codigo, value) { var item = saleItems.find(function(i) { return i.codigo === codigo; }); if (!item) return; var n = parseFloat(value); if (isNaN(n)) n = 1; if (item.unidad === 'uds') n = Math.round(n); if (n > item.stock) { showToast('Stock máximo: ' + item.stock, 'warning'); n = item.stock; } item.cantidad = n < 0.001 ? 0.001 : n; renderSale(); }
function setDescuento(codigo, value) { var item = saleItems.find(function(i) { return i.codigo === codigo; }); if (!item) return; var n = parseFloat(value) || 0; item.descuento = Math.max(0, Math.min(100, n)); renderSale(); }
function setCosto(codigo, value) { var item = saleItems.find(function(i) { return i.codigo === codigo; }); if (!item) return; var n = parseFloat(value); item.costo = isNaN(n) || n < 0 ? 0 : n; renderSale(); }
function removeItem(codigo) { saleItems = saleItems.filter(function(i) { return i.codigo !== codigo; }); renderSale(); }

function fmtCant(n) {
    var v = Number(n) || 0;
    return Number.isInteger(v) ? String(v) : v.toLocaleString('es-VE', { maximumFractionDigits: 3 });
}

function renderSale() {
    if (saleItems.length === 0) { saleBody.innerHTML = ''; emptyState.classList.remove('hidden-modal'); }
    else {
        emptyState.classList.add('hidden-modal');
        saleBody.innerHTML = saleItems.map(function(item) {
            var subtotalLinea = item.precio * item.cantidad;
            var descMonto = subtotalLinea * (item.descuento / 100);
            var totalLinea = subtotalLinea - descMonto;
            var stockText = item.cantidad >= item.stock ? '<span class="text-error text-[10px] font-bold">MAX</span>' : '';
            return '<tr data-codigo="' + item.codigo + '"><td class="px-3 py-2 font-mono-data text-secondary text-xs font-bold">' + item.codigo + '</td><td class="px-3 py-2"><span class="inline-block w-2 h-2 rounded-full mr-1 align-middle" style="background:' + (item.stock <= 0 ? '#ef4444' : item.stock <= 5 ? '#f59e0b' : '#22c55e') + '"></span>' + item.descripcion + ' <span class="text-[10px] text-on-surface-variant font-mono-data">' + (item.unidad || 'uds') + '</span> ' + stockText + '</td><td class="px-3 py-2"><div class="flex items-center justify-center gap-1"><button class="qty-btn w-6 h-6 rounded bg-surface-container-high text-sm" data-action="dec" data-codigo="' + item.codigo + '">-</button><input type="number" min="0.001" step="0.001" max="' + item.stock + '" value="' + item.cantidad + '" class="qty-input w-14 text-center border border-outline-variant/50 rounded font-mono-data text-sm py-0.5" data-codigo="' + item.codigo + '"/><button class="qty-btn w-6 h-6 rounded bg-surface-container-high text-sm" data-action="inc" data-codigo="' + item.codigo + '">+</button></div></td><td class="px-3 py-2 text-right"><input type="number" min="0" step="0.01" value="' + (item.costo || 0).toFixed(2) + '" class="costo-input w-16 text-right border border-outline-variant/50 rounded font-mono-data text-xs py-0.5" data-codigo="' + item.codigo + '"/></td><td class="px-3 py-2 text-right font-mono-data">' + item.precio.toFixed(2) + '</td><td class="px-3 py-2 text-center"><input type="number" min="0" max="100" step="0.1" value="' + item.descuento + '" class="desc-input w-14 text-center border border-outline-variant/50 rounded font-mono-data text-xs py-0.5" data-codigo="' + item.codigo + '"/></td><td class="px-3 py-2 text-right font-mono-data font-bold">' + totalLinea.toFixed(2) + '</td><td class="px-3 py-2 text-center"><button class="remove-btn text-error hover:opacity-70" data-codigo="' + item.codigo + '"><span class="material-symbols-outlined text-lg">delete</span></button></td></tr>';
        }).join('');
        saleBody.querySelectorAll('.qty-btn').forEach(function(btn) { btn.addEventListener('click', function() { updateQuantity(btn.dataset.codigo, btn.dataset.action === 'inc' ? 1 : -1); }); });
        saleBody.querySelectorAll('.qty-input').forEach(function(inp) { inp.addEventListener('change', function() { setQuantity(inp.dataset.codigo, inp.value); }); });
        saleBody.querySelectorAll('.desc-input').forEach(function(inp) { inp.addEventListener('change', function() { setDescuento(inp.dataset.codigo, inp.value); }); });
        saleBody.querySelectorAll('.costo-input').forEach(function(inp) { inp.addEventListener('change', function() { setCosto(inp.dataset.codigo, inp.value); }); });
        saleBody.querySelectorAll('.remove-btn').forEach(function(btn) { btn.addEventListener('click', function() { removeItem(btn.dataset.codigo); }); });
    }
    recalculateTotals();
}

function recalculateTotals() {
    var subtotal = saleItems.reduce(function(sum, i) { return sum + (i.precio * i.cantidad); }, 0);
    var descuentoTotal = saleItems.reduce(function(sum, i) { return sum + (i.precio * i.cantidad * (i.descuento / 100)); }, 0);
    var subtotalConDesc = subtotal - descuentoTotal;
    var iva = 0; var totalUsd = subtotalConDesc;
    if (!IVA_INCLUIDO) { iva = subtotalConDesc * IVA_RATE; totalUsd = subtotalConDesc + iva; }
    var bcvRate = parseFloat(bcvRateInput.value) || 0;
    var totalBs = totalUsd * bcvRate;
    sumSubtotal.textContent = subtotal.toFixed(2) + ' $';
    sumDescuento.textContent = '-' + descuentoTotal.toFixed(2) + ' $';
    sumIva.textContent = iva.toFixed(2) + ' $';
    sumTotalUsd.textContent = totalUsd.toFixed(2) + ' $';
    sumTotalBs.textContent = totalBs.toLocaleString('es-VE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' Bs';
    var mt = document.getElementById('mobile-total');
    if (mt) mt.textContent = totalUsd.toFixed(2) + ' $';
    return { subtotal: subtotal, descuento: descuentoTotal, iva: iva, totalUsd: totalUsd, totalBs: totalBs, bcvRate: bcvRate };
}
bcvRateInput.addEventListener('input', recalculateTotals);

