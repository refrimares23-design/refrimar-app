qnpForm.addEventListener('submit', async function(e) {
    e.preventDefault();
    var codigo = document.getElementById('qnp-codigo').value.trim();
    var descripcion = document.getElementById('qnp-descripcion').value.trim();
    var categoria = document.getElementById('qnp-categoria').value.trim();
    var costo = parseFloat(document.getElementById('qnp-costo').value) || 0;
    var precio = parseFloat(document.getElementById('qnp-precio').value);
    var stock = parseFloat(document.getElementById('qnp-stock').value) || 0;

    if (!codigo) { showToast('El código es obligatorio', 'error'); return; }
    if (!descripcion) { showToast('El nombre/descripción es obligatorio', 'error'); return; }
    if (isNaN(precio) || precio <= 0) { showToast('Ingresa un precio de venta válido', 'error'); return; }
    if (isNaN(stock) || stock < 0) { showToast('Ingresa un stock inicial válido', 'error'); return; }
    if (CATALOGO.some(function(p) { return p.codigo.toLowerCase() === codigo.toLowerCase(); })) { showToast('Ese código ya existe en el catálogo', 'error'); return; }

    qnpSaveBtn.disabled = true; qnpSaveBtn.textContent = 'GUARDANDO...';
    try {
        var actualSuc = window.getSucursalActual ? window.getSucursalActual() : { id: window.CASA_MATRIZ_ID, nombre: 'Casa Matriz' };
        var esCasaMatriz = !actualSuc || actualSuc.id === window.CASA_MATRIZ_ID;

        // El catálogo (productos) es único para todo el sistema. Si el producto
        // se está registrando estando en una sucursal, el stock inicial se
        // acredita ahí (sucursal_stock) y no en Casa Matriz. Una sola RPC
        // (atómica) crea el producto y acredita el stock a la sucursal.
        var res = await supabaseClient.rpc('producto_guardar', {
            p_codigo: codigo, p_descripcion: descripcion, p_categoria: categoria || null,
            p_costo: costo, p_precio: precio, p_stock: stock, p_stock_minimo: 0, p_unidad: 'uds',
            p_stock_inicial: esCasaMatriz ? 0 : stock,
