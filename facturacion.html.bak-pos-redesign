function estadoBadge(estado) {
    if (estado === 'anulada') return '<span class="text-xs font-bold px-2 py-1 rounded-full bg-error/10 text-error">ANULADA</span>';
    return '<span class="text-xs font-bold px-2 py-1 rounded-full bg-emerald-100 text-emerald-700">COMPLETADA</span>';
}
function renderSalesList(list) {
    var tbody = document.getElementById('sales-list');
    if (list.length === 0 && window.refContarPendientes() === 0) { tbody.innerHTML = '<tr><td colspan="7" class="text-center py-lg text-on-surface-variant text-sm">Sin ventas registradas.</td></tr>'; return; }
    var html = '';
    // Ventas pendientes de sincronización (guardadas sin internet)
    window.refObtenerCola().forEach(function(q) {
        var p = q.payload;
        var fecha = q.creado ? new Date(q.creado).toLocaleString('es-VE') : '-';
        var error = q.error ? ' title="' + q.error.replace(/"/g, '&quot;') + '"' : '';
        html += '<tr class="bg-amber-50" data-pendiente="' + q.id + '"><td class="px-4 py-3 font-mono-data text-amber-700 text-xs font-bold">#' + (p.p_numero || '-') + '</td><td class="px-4 py-3">' + (p.p_cliente_nombre || 'Consumidor Final') + '</td><td class="px-4 py-3 font-mono-data text-xs">' + fecha + '</td><td class="px-4 py-3"><span class="text-xs font-bold px-2 py-1 rounded-full bg-primary/10 text-primary">' + (p.p_metodo || '-') + '</span></td><td class="px-4 py-3 text-right font-mono-data font-bold">$' + Number(p.p_total_usd || 0).toLocaleString('es-VE', { minimumFractionDigits: 2 }) + '</td><td class="px-4 py-3 text-center">' + (q.error ? '<span class="text-xs font-bold px-2 py-1 rounded-full bg-error/10 text-error"' + error + '>ERROR</span>' : '<span class="text-xs font-bold px-2 py-1 rounded-full bg-amber-100 text-amber-700">PENDIENTE</span>') + '</td><td class="px-4 py-3 text-center"><button onclick="quitarPendiente(\'' + q.id + '\')" class="text-error hover:opacity-70" title="Quitar de la cola"><span class="material-symbols-outlined text-lg">delete</span></button></td></tr>';
    });
    // Ventas registradas en la base de datos
    html += list.map(function(v) {
        var fecha = v.created_at ? new Date(v.created_at).toLocaleDateString('es-VE') : '-';
        return '<tr class="' + (v.estado === 'anulada' ? 'opacity-50' : '') + '"><td class="px-4 py-3 font-mono-data text-secondary text-xs font-bold">#' + (v.numero || '-') + '</td><td class="px-4 py-3">' + (v.cliente_nombre || 'Consumidor Final') + '</td><td class="px-4 py-3 font-mono-data text-xs">' + fecha + '</td><td class="px-4 py-3"><span class="text-xs font-bold px-2 py-1 rounded-full bg-primary/10 text-primary">' + (v.metodo_pago || '-') + '</span></td><td class="px-4 py-3 text-right font-mono-data font-bold">$' + Number(v.total_usd || 0).toLocaleString('es-VE', { minimumFractionDigits: 2 }) + '</td><td class="px-4 py-3 text-center">' + estadoBadge(v.estado) + '</td><td class="px-4 py-3 text-center"><button onclick="printSaleTicket(\'' + v.id + '\')" class="text-primary hover:opacity-70" title="Reimprimir"><span class="material-symbols-outlined text-lg">print</span></button></td></tr>';
    }).join('');
    tbody.innerHTML = html;
}
