async function buscarClientes(q) {
    var ql = q.toLowerCase();
    var res = await supabaseClient.from('clientes').select('rif,nombre,telefono,email,limite_credito,saldo_pendiente,tipo')
        .or('rif.ilike.*' + ql + '*,nombre.ilike.*' + ql + '*')
        .order('nombre')
        .limit(8);
    var lista = (res.error || !res.data) ? [] : res.data;
    var exacto = lista.find(function(c) { return c.rif && c.rif.toLowerCase() === ql; });
    if (exacto) {
        clienteNombre.value = exacto.nombre || '';
        actualizarAdvertenciaCredito(exacto.saldo_pendiente, exacto.limite_credito);
        cerrarSugerenciasCliente();
        return;
    }
    actualizarAdvertenciaCredito(null, null);
    if (lista.length === 0) {
        clienteResults.innerHTML = '<div class="qnc-trigger flex items-center gap-2 px-md py-2.5 hover:bg-primary/5 cursor-pointer text-primary text-sm font-semibold"><span class="material-symbols-outlined text-lg">person_add</span>Registrar "' + q + '" como cliente nuevo</div>';
        clienteResults.classList.remove('hidden-modal');
        clienteResults.querySelector('.qnc-trigger').addEventListener('click', function() {
            cerrarSugerenciasCliente();
            openQuickNewClientModal(q);
        });
        return;
    }
    clienteResults.innerHTML = lista.map(function(c) {
        return '<div class="search-item flex items-center justify-between px-md py-2 hover:bg-primary/5 cursor-pointer border-b border-outline-variant/20 last:border-0" data-rif="' + c.rif + '"><div><div class="font-mono-data text-xs text-primary font-bold">' + (c.rif || '-') + '</div><div class="text-sm">' + c.nombre + '</div></div></div>';
    }).join('');
    clienteResults.classList.remove('hidden-modal');
    clienteResults.querySelectorAll('.search-item').forEach(function(el) {
        el.addEventListener('click', function() {
            var c = lista.find(function(x) { return x.rif === el.dataset.rif; });
            if (c) { clienteRif.value = c.rif || ''; clienteNombre.value = c.nombre || ''; }
            cerrarSugerenciasCliente();
            clienteNombre.focus();
        });
    });
}

clienteRif.addEventListener('input', function() {
    var q = clienteRif.value.trim();
    if (q.length < 3) { cerrarSugerenciasCliente(); actualizarAdvertenciaCredito(null, null); return; }
    clearTimeout(clienteTimer);
    clienteTimer = setTimeout(function() { buscarClientes(q); }, 300);
});

