function algunaModalAbierta() {
    var ids = ['modal-container', 'quick-new-product-modal', 'quick-new-client-modal', 'mixto-modal', 'credito-alerta-modal'];
    for (var i = 0; i < ids.length; i++) {
        var m = document.getElementById(ids[i]);
        if (m && !m.classList.contains('hidden-modal')) return true;
    }
    return false;
